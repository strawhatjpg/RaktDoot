{
  "name": "raktdoot",
  "version": "0.1.0",
  "private": true,
  "description": "WhatsApp-first blood access coordination platform for India (Cline AI Builder Hackathon).",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "test": "node --test \"packages/shared/tests/*.test.ts\" \"packages/copilot/tests/*.test.ts\"",
    "test:forecast": "cd services/forecast && .venv/bin/python -m pytest -q",
    "typecheck": "npm run typecheck -w @raktdoot/copilot",
    "copilot:demo": "npm run demo -w @raktdoot/copilot --"
  },
  "license": "MIT"
}