# Copy to .env and fill in real values. Never commit .env.

# --- App ---
APP_BASE_URL=http://localhost:3000
SESSION_SECRET=replace-with-a-long-random-string

# --- Database (SQLite for local development) ---
DATABASE_URL=file:./dev.db

# --- AI provider (chosen in the first build hour) ---
LLM_PROVIDER=gemini
LLM_MODEL=replace-with-model-id
LLM_API_KEY=replace-with-api-key

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=replace-with-webhook-verify-token
WHATSAPP_APP_SECRET=
WHATSAPP_BOT_NUMBER=

# --- App push notifications (Web Push / VAPID) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:team@example.com

# --- Forecast service (Python FastAPI) ---
FORECAST_SERVICE_URL=http://localhost:8000

# --- Feature flags ---
FEATURE_TOKEN_REWARDS=false