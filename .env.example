# Copy to the repository root .env. Workspace scripts load it explicitly.
# Never commit .env. No provider keys are needed for the core milestone.

# --- App ---
APP_BASE_URL=http://localhost:3000
SESSION_SECRET=replace-with-a-long-random-string
# Sessions currently use random opaque tokens with only SHA-256 hashes stored in DB.
# SESSION_SECRET is reserved for M1's login integration, not used by core sessions.
DEMO_MODE=false

# --- Database (SQLite for local development) ---
DATABASE_URL=file:./dev.db
# SQLite URL is relative to apps/web/prisma/schema.prisma. For production set an
# absolute persistent SQLite path or plan a separate PostgreSQL schema migration.

# --- AI providers (FREE tiers only) ---
# Primary: Google Gemini free tier (multilingual extraction, translation, audio transcription, Copilot)
# Key from https://aistudio.google.com/apikey. Pick a current Flash / Flash-Lite model shown as free in AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=replace-with-free-flash-model-id
# Fallback: Groq free plan (OpenAI-compatible). Used if Gemini rate-limits.
# Key from https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_STT_MODEL=whisper-large-v3-turbo

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=replace-with-webhook-verify-token
WHATSAPP_APP_SECRET=
WHATSAPP_BOT_NUMBER=
WHATSAPP_API_VERSION=v25.0

# --- App push notifications (Web Push / VAPID) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:team@example.com

# --- Forecast service (Python FastAPI) ---
FORECAST_SERVICE_URL=http://localhost:8000

# --- Feature flags ---
FEATURE_TOKEN_REWARDS=false