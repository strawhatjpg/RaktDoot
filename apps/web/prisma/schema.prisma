generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  REQUESTER
  DONOR
  HOSPITAL_STAFF
  BLOOD_CENTRE_STAFF
  COORDINATOR
  ADMIN
}

enum RequestStatus {
  DRAFT
  AWAITING_CONFIRMATION
  OPEN
  CENTRES_LISTED
  STOCK_CONFIRMED
  OUTREACH_ACTIVE
  DONOR_ACCEPTED
  DONOR_ARRIVED
  DONATION_CONFIRMED
  CLOSED
}

enum VerificationStatus {
  UNVERIFIED
  PENDING_REVIEW
  VERIFIED
  REJECTED
}

enum FinalOutcome {
  FULFILLED
  CANCELLED
  EXPIRED
  UNRESOLVED
}

enum BloodComponent {
  WHOLE_BLOOD
  PACKED_RED_CELLS
  PLATELETS
  PLASMA
  UNKNOWN
}

enum ConsentType {
  TERMS
  URGENT_ALERTS
  DONATION_REMINDERS
  LOCATION_STORAGE
  CONTACT_SHARING
}

enum NotificationChannel {
  WHATSAPP
  APP_PUSH
}

enum Availability {
  AVAILABLE
  PAUSED
  UNAVAILABLE
}

enum StockStatus {
  REPORTED
  CONFIRMED
  RESERVED
}

enum InviteStatus {
  INVITED
  ACCEPTED
  DECLINED
  PAUSED
  EXPIRED
  STOOD_DOWN
  ARRIVED
  DONATED
  DEFERRED
  WITHDRAWN
}

enum NotificationStatus {
  PENDING
  SENDING
  SENT
  SIMULATED
  FAILED
  CANCELLED
}

model User {
  id                String    @id @default(cuid())
  phone             String?   @unique
  email             String?   @unique
  name              String
  preferredLanguage String    @default("en")
  role              UserRole  @default(REQUESTER)
  verifiedAt        DateTime?
  hospitalId        String?
  hospital          Hospital? @relation(fields: [hospitalId], references: [id])
  district          String?
  isSimulated       Boolean   @default(false)
  createdAt         DateTime  @default(now())
  sessions          Session[]
  donorProfile      DonorProfile?
  consents          Consent[]
  requests          BloodRequest[]
  events            RequestEvent[]
  audits            AuditLog[]
  oauthAccounts     OAuthAccount[]
  invites           OutreachInvite[]
  notifications     Notification[]
  awards            RecognitionAward[]
  reminderLogs      ReminderLog[]
}

model OAuthAccount {
  id        String   @id @default(cuid())
  provider  String
  subject   String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([provider, subject])
  @@index([userId])
}

/** WhatsApp conversation state, keyed by the verified sender number. */
model BotConversation {
  phone            String   @id
  state            String
  pendingLat       Float?
  pendingLng       Float?
  pendingAreaLabel String?
  pendingSource    String?
  updatedAt        DateTime @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Hospital {
  id          String   @id @default(cuid())
  name        String
  district    String
  lat         Float
  lng         Float
  isSimulated Boolean  @default(false)
  staff       User[]
  requests    BloodRequest[]
}

model BloodCentre {
  id          String   @id @default(cuid())
  name        String
  licenceNo   String?
  phone       String?
  address     String
  district    String
  lat         Float
  lng         Float
  isSimulated Boolean  @default(false)
  snapshots   StockSnapshot[]
}

model StockSnapshot {
  id          String         @id @default(cuid())
  centreId    String
  centre      BloodCentre    @relation(fields: [centreId], references: [id], onDelete: Cascade)
  bloodGroup  String
  component   BloodComponent
  units       Int
  status      StockStatus    @default(REPORTED)
  source      String
  isSimulated Boolean        @default(false)
  recordedAt  DateTime       @default(now())

  @@index([centreId, bloodGroup, component, recordedAt])
}

model DonorProfile {
  userId                String       @id
  user                  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  bloodGroup            String
  sex                   String       @default("UNSPECIFIED")
  travelRadiusKm        Float        @default(15)
  availability          Availability @default(PAUSED)
  availabilityUpdatedAt DateTime     @default(now())
  unavailableUntil      DateTime?
  lastDonationAt        DateTime?
  /** SELF_REPORTED, SYNTHETIC_SEED or (future) CENTRE_CONFIRMED. */
  lastDonationSource    String?
  location              DonorLocation?
}

model DonorLocation {
  userId    String       @id
  donor     DonorProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)
  lat       Float
  lng       Float
  areaLabel String?
  source    String
  updatedAt DateTime     @default(now())
}

model Consent {
  id           Int                  @id @default(autoincrement())
  userId       String
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         ConsentType
  channel      NotificationChannel?
  requestId    String?
  request      BloodRequest?        @relation(fields: [requestId], references: [id])
  granted      Boolean
  recordedAt   DateTime             @default(now())
  source       String
  termsVersion String

  @@index([userId, type, channel, recordedAt, id])
}

model BloodRequest {
  id             String             @id @default(cuid())
  requesterId    String
  requester      User               @relation(fields: [requesterId], references: [id])
  hospitalId     String
  hospital       Hospital           @relation(fields: [hospitalId], references: [id])
  bloodGroup     String
  component      BloodComponent
  units          Int
  neededBy       DateTime
  language       String
  status         RequestStatus      @default(OPEN)
  verification   VerificationStatus @default(PENDING_REVIEW)
  outcome        FinalOutcome?
  isSimulated    Boolean            @default(false)
  idempotencyKey String
  payloadHash    String
  verifiedById   String?
  verifiedAt     DateTime?
  /** Donors currently committed (accepted/arrived/donated). Claimed atomically. */
  acceptedCount  Int                @default(0)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  events         RequestEvent[]
  consents       Consent[]
  waves          OutreachWave[]
  invites        OutreachInvite[]
  fulfilments    FulfilmentRecord[]

  @@unique([requesterId, idempotencyKey])
  @@index([hospitalId, status, createdAt])
}

model RequestEvent {
  id         String        @id @default(cuid())
  requestId  String
  request    BloodRequest  @relation(fields: [requestId], references: [id])
  actorId    String
  actor      User          @relation(fields: [actorId], references: [id])
  fromStatus RequestStatus?
  toStatus   RequestStatus
  kind       String        @default("STATUS_CHANGED")
  note       String?
  createdAt  DateTime      @default(now())

  @@index([requestId, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  action    String
  entity    String
  entityId  String
  createdAt DateTime @default(now())

  @@index([entity, entityId, createdAt])
}

model OutreachWave {
  id          String           @id @default(cuid())
  requestId   String
  request     BloodRequest     @relation(fields: [requestId], references: [id])
  waveNumber  Int
  radiusKm    Float
  size        Int
  startedById String
  startedAt   DateTime         @default(now())
  closesAt    DateTime
  closedAt    DateTime?
  invites     OutreachInvite[]

  @@unique([requestId, waveNumber])
  @@index([closedAt, closesAt])
}

model OutreachInvite {
  id          String            @id @default(cuid())
  waveId      String
  wave        OutreachWave      @relation(fields: [waveId], references: [id])
  requestId   String
  request     BloodRequest      @relation(fields: [requestId], references: [id])
  donorId     String
  donor       User              @relation(fields: [donorId], references: [id])
  score       Float
  distanceKm  Float
  reasons     String
  status      InviteStatus      @default(INVITED)
  respondedAt DateTime?
  arrivedAt   DateTime?
  donatedAt   DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  award       RecognitionAward?

  @@unique([requestId, donorId])
  @@index([donorId, status])
  @@index([requestId, status])
}

/** Durable outbox. Every outbound WhatsApp message goes through here. */
model Notification {
  id                String              @id @default(cuid())
  userId            String?
  user              User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  toPhone           String
  channel           NotificationChannel
  purpose           String
  payload           String
  status            NotificationStatus  @default(PENDING)
  attempts          Int                 @default(0)
  lastError         String?
  providerMessageId String?
  requestId         String?
  inviteId          String?
  dedupeKey         String              @unique
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  sentAt            DateTime?

  @@index([status, createdAt])
  @@index([toPhone, createdAt])
  @@index([inviteId])
}

/** Units actually issued for a request. Required before closing as FULFILLED. */
model FulfilmentRecord {
  id           String       @id @default(cuid())
  requestId    String
  request      BloodRequest @relation(fields: [requestId], references: [id])
  units        Int
  source       String
  recordedById String
  note         String?
  createdAt    DateTime     @default(now())

  @@index([requestId])
}

model RecognitionAward {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  code      String         @unique
  inviteId  String         @unique
  invite    OutreachInvite @relation(fields: [inviteId], references: [id])
  awardedAt DateTime       @default(now())

  @@index([userId])
}

model ReminderLog {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dueAt          DateTime
  notificationId String?
  createdAt      DateTime @default(now())

  @@unique([userId, dueAt])
}