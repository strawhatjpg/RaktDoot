{
  "name": "@raktdoot/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env scripts/next.mjs dev",
    "build": "node --env-file-if-exists=../../.env scripts/next.mjs build",
    "start": "node --env-file-if-exists=../../.env scripts/next.mjs start",
    "typecheck": "node scripts/next.mjs typegen && tsc --noEmit",
    "db:generate": "node --env-file-if-exists=../../.env ../../node_modules/prisma/build/index.js generate",
    "db:migrate": "node --env-file-if-exists=../../.env ../../node_modules/prisma/build/index.js migrate deploy",
    "db:seed": "node --env-file-if-exists=../../.env prisma/seed.ts",
    "demo:session": "node --env-file-if-exists=../../.env scripts/demo-session.ts",
    "worker": "node --env-file-if-exists=../../.env scripts/worker.ts",
    "test:integration": "node scripts/test-integration.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "test:demo": "node scripts/demo-e2e.mjs"
  },
  "dependencies": {
    "@prisma/client": "~6.19.0",
    "@raktdoot/bot": "0.1.0",
    "@raktdoot/copilot": "0.1.0",
    "@raktdoot/shared": "0.1.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prisma": "~6.19.0"
  }
}